{
  "name": "localingo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A private, gamified language tutor with local speech, review, grammar, and lesson generation.",
  "homepage": "https://baditaflorin.github.io/localingo/",
  "repository": {
    "type": "git",
    "url": "https://github.com/baditaflorin/localingo.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-docs.mjs && npm run typecheck && vite build && node scripts/write-build-metadata.mjs && node scripts/copy-404.mjs",
    "data": "node scripts/validate-course.mjs",
    "lint": "eslint . --max-warnings=0",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "bash scripts/smoke.sh",
    "typecheck": "tsc --noEmit",
    "pages-preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.1-dev106.0",
    "@tanstack/react-query": "^5.90.11",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.25",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
